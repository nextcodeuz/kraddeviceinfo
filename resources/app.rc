// krad.device.info - Windows version resources
#include <windows.h>

#define VER_FILEVERSION             1,1,0,0
#define VER_FILEVERSION_STR         "1.1.0.0\0"
#define VER_PRODUCTVERSION          1,1,0,0
#define VER_PRODUCTVERSION_STR      "1.1.0.0\0"

#define APP_NAME_STR    "KradDeviceInfo"
#define APP_ID_STR      "krad.device.info"
#define APP_DESC        "Complete Windows hardware and software inventory"

IDI_ICON1 ICON "icons/krad.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Krad"
            VALUE "FileDescription",  APP_DESC
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "kraddeviceinfo"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "kraddeviceinfo.exe"
            VALUE "ProductName",      APP_NAME_STR
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
            VALUE "Comments",         APP_ID_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// embed manifest (works for both MSVC and MinGW via windres)
1 RT_MANIFEST "app.manifest"
